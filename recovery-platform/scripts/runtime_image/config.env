# Recoverix immutable Recovery Runtime image build — paths only.
# NEVER set ROOTFS to host /. Host boot modification is forbidden in this pipeline.

ROOTFS="/recovery/build/rootfs"
RUNTIME_DIR="/recovery/build/runtime"
RUNTIME_SQUASHFS="${RUNTIME_DIR}/runtime.squashfs"
REPORT_DIR="/recovery/build/reports/runtime-build"

# Kernel / initramfs (must match minimized rootfs)
KEEP_KERNEL_FLAVOR="6.8.0-117-generic"

# Squashfs image label (embedded in filesystem for identification)
RUNTIME_SQUASHFS_LABEL="RECOVERIX_RUNTIME"

# Host boot partition path (initramfs + GRUB). NEVER bake under /recovery/build/rootfs.
# Artifacts: /recovery/build/runtime/*  ->  deploy/30_stage_host_boot.sh  ->  /boot/recoverix/
RUNTIME_BOOT_STAGING="boot/recoverix"

# Squashfs layout verify: prefer this dir for unsquashfs extract (fallback: /var/tmp)
RECOVERY_SQUASHFS_VERIFY_TMP="/recovery/tmp"

# AMDGPU firmware: copied from host (no rootfs chroot apt)
RUNTIME_HOST_FIRMWARE_AMDGPU="/usr/lib/firmware/amdgpu"
RUNTIME_MIN_AMDGPU_FIRMWARE_FILES="${RUNTIME_MIN_AMDGPU_FIRMWARE_FILES:-50}"
RUNTIME_MIN_AMDGPU_FIRMWARE_BIN="${RUNTIME_MIN_AMDGPU_FIRMWARE_BIN:-10}"

# Runtime utility installed into squashfs (see lib/runtime_tools_install.sh)
RUNTIME_HEALTH_CHECK_PATH="/usr/local/sbin/recoverix-health-check"
RUNTIME_IMMUTABLE_TEST_PATH="/usr/local/sbin/recoverix-immutable-test"

# GTK Recovery UI skeleton (mock backup gating; no destructive restore)
RUNTIME_RECOVERY_UI_LAUNCHER="/usr/local/sbin/recoverix-recovery-ui"
RUNTIME_RECOVERY_UI_AUTOSTART="/etc/xdg/autostart/recoverix-recovery-ui.desktop"
RUNTIME_RECOVERY_UI_LOG="/var/log/recoverix-ui.log"
RUNTIME_MOCK_VALID_BACKUP_MARKER="/tmp/recoverix-valid-backup"

# Recoverix runtime dedicated session identity (host users must not be imported)
RECOVERIX_RUNTIME_USER="${RECOVERIX_RUNTIME_USER:-recoverix}"
RECOVERIX_RUNTIME_GROUP="${RECOVERIX_RUNTIME_GROUP:-recoverix}"
RECOVERIX_RUNTIME_UID="${RECOVERIX_RUNTIME_UID:-2000}"
RECOVERIX_RUNTIME_GID="${RECOVERIX_RUNTIME_GID:-2000}"
RECOVERIX_RUNTIME_HOME="${RECOVERIX_RUNTIME_HOME:-/home/recoverix}"
RECOVERIX_RUNTIME_ALLOW_SUDO="${RECOVERIX_RUNTIME_ALLOW_SUDO:-0}"
RECOVERIX_RUNTIME_AUTOLOGIN="${RECOVERIX_RUNTIME_AUTOLOGIN:-1}"
# Console login for runtime/forensic (recoverix user); also enables tty autologin on recoverix.root=1
RECOVERIX_RUNTIME_CONSOLE_PASSWORD="${RECOVERIX_RUNTIME_CONSOLE_PASSWORD:-recoverix}"
RECOVERIX_RUNTIME_CONSOLE_AUTOLOGIN="${RECOVERIX_RUNTIME_CONSOLE_AUTOLOGIN:-1}"
# Forensic limited sudo (recoverix.root=1 or recoverix.debug.xorg=1 at boot only)
RECOVERIX_RUNTIME_FORENSIC_SUDO="${RECOVERIX_RUNTIME_FORENSIC_SUDO:-1}"
RECOVERIX_FORENSIC_SUDO_LOG="${RECOVERIX_FORENSIC_SUDO_LOG:-/var/log/recoverix-forensic-sudo.log}"

# Runtime build safety (disk pressure, free space, artifact retention)
RUNTIME_BUILD_MIN_FREE_GB="${RUNTIME_BUILD_MIN_FREE_GB:-8}"
RUNTIME_DISK_WARN_PERCENT="${RUNTIME_DISK_WARN_PERCENT:-90}"
RUNTIME_DISK_FAIL_PERCENT="${RUNTIME_DISK_FAIL_PERCENT:-95}"
RUNTIME_DISK_HARD_FAIL_PERCENT="${RUNTIME_DISK_HARD_FAIL_PERCENT:-99}"
RUNTIME_ARTIFACT_REPORT_KEEP="${RUNTIME_ARTIFACT_REPORT_KEEP:-20}"
RUNTIME_SQUASHFS_BACKUP_KEEP="${RUNTIME_SQUASHFS_BACKUP_KEEP:-3}"
# Host rsync bootstrap: DISABLED by default (runaway prevention). Dev-only: export RECOVERIX_DEV_HOST_RSYNC_BOOTSTRAP=1
RECOVERIX_DEV_HOST_RSYNC_BOOTSTRAP="${RECOVERIX_DEV_HOST_RSYNC_BOOTSTRAP:-0}"

# Production rootfs build: debootstrap (primary) | auto | snapshot-only
RECOVERIX_RUNTIME_BUILD_MODE="${RECOVERIX_RUNTIME_BUILD_MODE:-debootstrap}"
RECOVERIX_FORCE_DEBOOTSTRAP="${RECOVERIX_FORCE_DEBOOTSTRAP:-0}"
RECOVERIX_ALLOW_HOST_CLONE_SNAPSHOT="${RECOVERIX_ALLOW_HOST_CLONE_SNAPSHOT:-0}"

# debootstrap settings (Ubuntu 22.04 jammy minimal runtime seed)
RUNTIME_DEBOOTSTRAP_SUITE="${RUNTIME_DEBOOTSTRAP_SUITE:-jammy}"
RUNTIME_DEBOOTSTRAP_VARIANT="${RUNTIME_DEBOOTSTRAP_VARIANT:-minbase}"
RUNTIME_DEBOOTSTRAP_MIRROR="${RUNTIME_DEBOOTSTRAP_MIRROR:-http://archive.ubuntu.com/ubuntu/}"
RUNTIME_DEBOOTSTRAP_MIN_FREE_GB="${RUNTIME_DEBOOTSTRAP_MIN_FREE_GB:-12}"

# Runtime rootfs apt repositories (production debootstrap; partclone needs universe)
RUNTIME_APT_COMPONENTS="${RUNTIME_APT_COMPONENTS:-main restricted universe multiverse}"
RUNTIME_APT_ENABLE_UPDATES="${RUNTIME_APT_ENABLE_UPDATES:-1}"
RUNTIME_APT_ENABLE_SECURITY="${RUNTIME_APT_ENABLE_SECURITY:-1}"

# Strict minimal apt install (production runtime purity)
RECOVERIX_APT_INSTALL_RETRIES="${RECOVERIX_APT_INSTALL_RETRIES:-3}"
RECOVERIX_APT_SIMULATE_BEFORE_INSTALL="${RECOVERIX_APT_SIMULATE_BEFORE_INSTALL:-1}"

# Rootfs size goals (GiB, before squashfs)
RUNTIME_ROOTFS_SIZE_TARGET_GB="${RUNTIME_ROOTFS_SIZE_TARGET_GB:-3}"
RUNTIME_ROOTFS_SIZE_WARN_GB="${RUNTIME_ROOTFS_SIZE_WARN_GB:-3}"
RUNTIME_ROOTFS_SIZE_FAIL_GB="${RUNTIME_ROOTFS_SIZE_FAIL_GB:-5}"
RUNTIME_APT_CACHE_WARN_MB="${RUNTIME_APT_CACHE_WARN_MB:-300}"
RUNTIME_APT_CACHE_FAIL_MB="${RUNTIME_APT_CACHE_FAIL_MB:-1024}"
RECOVERIX_RESET_MACHINE_ID="${RECOVERIX_RESET_MACHINE_ID:-1}"

# After successful squashfs: 0 = move rootfs aside to free disk; 1 = keep for debug (default)
KEEP_RUNTIME_ROOTFS="${KEEP_RUNTIME_ROOTFS:-1}"

# ESP staging (deploy/40_stage_esp_runtime.sh) — additive only; no NVRAM
RECOVERIX_ESP_TIMEOUT_SEC="${RECOVERIX_ESP_TIMEOUT_SEC:-30}"
RECOVERIX_ESP_MOUNT="${RECOVERIX_ESP_MOUNT:-/mnt/recoverix-esp-staging}"
RECOVERIX_ESP_REL_DIR="${RECOVERIX_ESP_REL_DIR:-EFI/Recoverix}"
RECOVERIX_ESP_ACTIVE_REL_DIR="${RECOVERIX_ESP_ACTIVE_REL_DIR:-EFI/RecoveryBoot}"
RECOVERIX_ESP_DIRECT_REL_DIR="${RECOVERIX_ESP_DIRECT_REL_DIR:-EFI/RecoverixDirect}"
RECOVERIX_BOOT_TIMEOUT_SEC="${RECOVERIX_BOOT_TIMEOUT_SEC:-2}"
RECOVERIX_BOOT_HOTKEY="${RECOVERIX_BOOT_HOTKEY:-q}"
RECOVERIX_ESP_MIN_FREE_BYTES="${RECOVERIX_ESP_MIN_FREE_BYTES:-16777216}"
RECOVERIX_ESP_STAGE_SHIM="${RECOVERIX_ESP_STAGE_SHIM:-0}"
# 1 = remove /etc/grub.d/41_recoverix during ESP stage (keep Ubuntu/RecoveryBoot chains separate)
RECOVERIX_PURGE_HOST_GRUB_ENTRIES="${RECOVERIX_PURGE_HOST_GRUB_ENTRIES:-1}"
# Legacy opt-in only: append Recoverix entries to /boot/grub/grub.cfg via update-grub
RECOVERIX_INSTALL_HOST_GRUB="${RECOVERIX_INSTALL_HOST_GRUB:-0}"

# GUI session / forensic logging (runtime squashfs)
RECOVERIX_GUI_FORENSIC_LOG="${RECOVERIX_GUI_FORENSIC_LOG:-/var/log/recoverix-gui.log}"
RECOVERIX_XORG_FORENSIC_LOG="${RECOVERIX_XORG_FORENSIC_LOG:-/var/log/recoverix-xorg.log}"
RECOVERIX_GUI_FALLBACK_TIMER_SEC="${RECOVERIX_GUI_FALLBACK_TIMER_SEC:-120}"
RECOVERIX_XORG_WATCHDOG_SEC="${RECOVERIX_XORG_WATCHDOG_SEC:-20}"
