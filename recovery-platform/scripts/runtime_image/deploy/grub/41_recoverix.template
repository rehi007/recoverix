#!/bin/sh
exec tail -n +3 $0
# Recoverix Runtime — additive GRUB menu (generated by 31_install_grub_entry.sh)
# Does NOT change GRUB_DEFAULT. Remove this file + update-grub to rollback.

menuentry "Recoverix Runtime (immutable overlay)" --class recoverix {
    recordfail
    load_video
    insmod gzio
    insmod part_gpt
    insmod ext2
    search --no-floppy --fs-uuid --set=root @RECOVERY_UUID@
    echo "Loading Recoverix Runtime..."
    linux   /boot/vmlinuz-@KERNEL_VERSION@ \
        root=UUID=@RECOVERY_UUID@ \
        recoverix.root=1 \
        recoverix.uuid=@RECOVERY_UUID@ \
        ro quiet splash
    initrd  /boot/recoverix/initrd.img-@KERNEL_VERSION@-recoverix
}

menuentry "Recoverix Runtime (debug shell)" --class recoverix {
    search --no-floppy --fs-uuid --set=root @RECOVERY_UUID@
    linux   /boot/vmlinuz-@KERNEL_VERSION@ \
        root=UUID=@RECOVERY_UUID@ \
        recoverix.root=1 \
        recoverix.uuid=@RECOVERY_UUID@ \
        recoverix.debug=1 \
        ro single
    initrd  /boot/recoverix/initrd.img-@KERNEL_VERSION@-recoverix
}

menuentry "Recoverix Runtime (xorg forensic GUI)" --class recoverix {
    search --no-floppy --fs-uuid --set=root @RECOVERY_UUID@
    linux   /boot/vmlinuz-@KERNEL_VERSION@ \
        root=UUID=@RECOVERY_UUID@ \
        recoverix.root=1 \
        recoverix.uuid=@RECOVERY_UUID@ \
        recoverix.debug.xorg=1 \
        ro quiet splash systemd.unit=graphical.target
    initrd  /boot/recoverix/initrd.img-@KERNEL_VERSION@-recoverix
}

menuentry "Recoverix Runtime (xorg forensic console)" --class recoverix {
    search --no-floppy --fs-uuid --set=root @RECOVERY_UUID@
    linux   /boot/vmlinuz-@KERNEL_VERSION@ \
        root=UUID=@RECOVERY_UUID@ \
        recoverix.root=1 \
        recoverix.uuid=@RECOVERY_UUID@ \
        recoverix.debug.xorg=1 \
        ro quiet splash systemd.unit=multi-user.target
    initrd  /boot/recoverix/initrd.img-@KERNEL_VERSION@-recoverix
}
