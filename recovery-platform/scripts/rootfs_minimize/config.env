# Recovery Runtime rootfs minimization — edit only this path if needed.
# Host system must NEVER be set here.

ROOTFS="/recovery/build/rootfs"

# Dry-run for apt operations (1=dry-run/simulate, 0=apply)
APT_DRY_RUN="${APT_DRY_RUN:-1}"

# Keep only these locales (comma-separated); others removed in prune phase
KEEP_LOCALES="en_US.UTF-8,ko_KR.UTF-8"

# Kernel packages to KEEP (purge other linux-image/linux-modules* not matching)
KEEP_KERNEL_FLAVOR="6.8.0-117-generic"

# Report output directory (on host, outside rootfs)
REPORT_DIR="/recovery/build/reports/rootfs-minimize"
