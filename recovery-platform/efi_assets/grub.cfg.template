# Generated by recovery-platform grub.generate_grub_config
# Default boot: Windows Boot Manager (menu index ${DEFAULT_INDEX})
# Press Q within ${TIMEOUT}s to boot Recovery Linux

set timeout=${TIMEOUT}
set default=${DEFAULT_INDEX}
set timeout_style=hidden

insmod part_gpt
insmod fat
insmod chain
insmod regexp
menuentry "Windows Boot Manager" {
    # Primary: file-based ESP search (kept as default).
    search --file --no-floppy --set=root ${WINDOWS_EFI_PATH}
    # TODO(fallback): search --file may fail on some firmware/GRUB builds.
    #   - Add search.fs_uuid <ESP_UUID> fallback after live ESP discovery
    #   - Re-verify Windows Boot Manager path before chainloader
    #   - On search failure: prioritize Windows boot survivability (never fall through to Recovery)
    chainloader ${WINDOWS_EFI_PATH}
}

menuentry "Recovery Linux - Restore System" --hotkey=q {
    clear
    linux ${RECOVERY_KERNEL} quiet recovery_mode=1
    initrd ${RECOVERY_INITRD}
}
